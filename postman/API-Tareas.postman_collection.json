        {
          "name": "Iniciar sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Devuelve token', () => pm.expect(d.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', d.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
