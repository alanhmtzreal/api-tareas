{
  "info": {
    "name": "API de Tareas",
    "description": "Pruebas de la API. Ejecuta la colección completa en orden con el servidor encendido (npm start).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Usuario único por ejecución: la colección se puede correr varias veces",
          "if (!pm.collectionVariables.get('usuario')) {",
          "  const marca = String(Date.now()).slice(-8);",
          "  pm.collectionVariables.set('usuario', `postman${marca}`);",
          "  pm.collectionVariables.set('password', `prueba-${marca}`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "usuario",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tareaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Tareas sin token",
          "event": [
            {
              "listen": "test",
